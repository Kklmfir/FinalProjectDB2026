# MDG App — Environment Configuration
# Salin file ini ke .env dan sesuaikan nilainya
# cp .env.example .env

# ─── Application ──────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_NAME="MDG - My Dompet Gue"

# ─── Database Mode ────────────────────────────────────────────
# Pilih: local (MySQL) atau supabase (PostgreSQL cloud)
DB_MODE=local

# ─── MySQL Local Configuration ────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=final-project-db2026
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# ─── Supabase PostgreSQL Configuration (Optional) ─────────────
# Isi jika menggunakan Supabase sebagai database cloud.
# Dapatkan nilai ini dari: https://supabase.com/dashboard → Settings → Database
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB=postgres
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_USERNAME=postgres
SUPABASE_PASSWORD=
